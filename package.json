{
  "name": "@kissmybutton/mc-attr",
  "version": "0.0.3",
  "description": "MotorCortex Effect plugin for animating SVG and DOM element attributes",
  "main": "dist/bundle.cjs.js",
  "module": "dist/bundle.esm.js",
  "browser": "dist/bundle.umd.js",
  "type": "module",
  "author": "DonkeyClip",
  "repository": {
    "type": "git",
    "url": "https://github.com/kissmybutton/mc-attr.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "rollup -c",
    "start": "npm run build:lib && concurrently -c \"cyan.bold,magenta.bold\" \"npm:build:lib -- -w\"  \"npm:start:demo\" ",
    "start:demo": "webpack serve --mode=development --config ./demo/webpack.config.cjs",
    "build:demo": "webpack --mode=production --config ./demo/webpack.config.cjs",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "keywords": [
    "motorcortex",
    "svg",
    "attributes",
    "animation",
    "plugin"
  ],
  "peerDependencies": {
    "@donkeyclip/motorcortex": ">=9.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^7.25.0",
    "@babel/plugin-syntax-jsx": "^7.24.0",
    "@babel/plugin-transform-react-jsx": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@donkeyclip/motorcortex": "^9.24.0",
    "@donkeyclip/motorcortex-player": "^2.17.0",
    "@rollup/plugin-babel": "^6.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "concurrently": "^9.0.0",
    "css-loader": "^7.0.0",
    "html-webpack-plugin": "^5.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^5.0.0"
  }
}
